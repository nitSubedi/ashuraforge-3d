; AshuraForge 3D — Godot 4 project
; Engine configuration. Input actions are registered in code (scripts/game_manager.gd)
; so this file stays minimal and reviewable.

config_version=5

[application]

config/name="AshuraForge 3D"
config/description="A 3D roguelike reimagining of AshuraForge. Third-person, Godot 4, CC0 assets."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Game="*res://scripts/game_manager.gd"

[rendering]

anti_aliasing/quality/msaa_3d=2
